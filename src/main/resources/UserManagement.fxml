<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" stylesheets="/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UserManagementController">
   <content>
      <VBox spacing="30.0" styleClass="content-area">
         <children>
      <FlowPane hgap="20.0" prefWrapLength="940.0" vgap="12.0">
         <children>
            <VBox>
               <children>
                  <Label styleClass="section-title" text="User Management" />
                  <Label styleClass="text-secondary" text="Manage all registered users, roles, and account statuses" />
               </children>
            </VBox>
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <TextField fx:id="searchField" prefWidth="250.0" promptText="Search users..." styleClass="auth-field" />
                  <Button mnemonicParsing="false" onAction="#handleAddUser" styleClass="action-btn" text="Add User" />
                  <Button mnemonicParsing="false" onAction="#handleRefresh" styleClass="action-btn" text="Refresh" />
               </children>
            </HBox>
         </children>
      </FlowPane>
      
      <Separator prefWidth="200.0" />
      
      <VBox spacing="20.0" styleClass="card" VBox.vgrow="ALWAYS">
         <children>
            <VBox fx:id="userCardsContainer" spacing="10.0" VBox.vgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
      
      <HBox alignment="CENTER_RIGHT" spacing="15.0">
         <children>
            <Label fx:id="totalUsersLabel" styleClass="text-secondary" text="Total Users: 0" />
         </children>
      </HBox>
         </children>
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
      </VBox>
   </content>
</ScrollPane>

