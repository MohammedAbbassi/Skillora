<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            styleClass="workflow-scroll"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AiQuizGeneratorController">
    <content>
        <VBox spacing="22">
            <padding>
                <Insets top="34" right="40" bottom="34" left="40"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="6">
                    <Label text="Generation intelligente de quiz" styleClass="page-title"/>
                    <Label fx:id="quizLabel" text="Quiz" styleClass="page-subtitle"/>
                    <Label text="La generation utilise la matiere, le titre et le niveau du quiz selectionne."
                           wrapText="true" styleClass="workflow-hint"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Retour" onAction="#backToQuestionForm" styleClass="ghost-button"/>
            </HBox>

            <VBox spacing="18" maxWidth="980" styleClass="ai-generator-panel">
                <VBox spacing="8">
                    <Label text="Matiere / theme du quiz" styleClass="field-label"/>
                    <TextArea fx:id="topicTextArea" prefRowCount="4" wrapText="true"
                              promptText="Rempli automatiquement depuis le quiz selectionne. Ajoutez seulement une precision si besoin, par exemple : Oracle SQL et PL/SQL."/>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="8">
                        <Label text="Questions" styleClass="field-label"/>
                        <TextField fx:id="questionCountField" prefWidth="120"/>
                    </VBox>
                    <VBox spacing="8">
                        <Label text="Difficulte" styleClass="field-label"/>
                        <ComboBox fx:id="difficultyCombo" prefWidth="190"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="generateButton" text="Generer avec IA" onAction="#generateWithAi"
                            styleClass="ai-button"/>
                    <Button fx:id="saveButton" text="Inserer dans le quiz" onAction="#saveGeneratedQuiz"
                            styleClass="primary-button"/>
                </HBox>

                <Label fx:id="statusLabel" text="Configurez la generation puis lancez l'IA."
                       wrapText="true" styleClass="page-subtitle"/>
            </VBox>

            <VBox spacing="12" maxWidth="980" styleClass="timeline-card">
                <Label text="Previsualisation IA" styleClass="section-title"/>
                <ListView fx:id="previewListView" minHeight="360" prefHeight="520" maxHeight="520"
                          styleClass="ai-preview-list"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
