<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CoursListController">

    <VBox spacing="25" alignment="TOP_CENTER">
        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
        
        <!-- Assistant de Navigation Section -->
        <VBox fx:id="navigationAssistantCard" maxWidth="1000" spacing="15" visible="false" managed="false" 
              style="-fx-background-color: linear-gradient(to right, #6366f1, #a855f7); -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(99,102,241,0.3), 10, 0, 0, 5);">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="🧭 Assistant de Navigation" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="✕" onAction="#onDismissAssistant" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-background-radius: 5;"/>
            </HBox>
            <Label fx:id="guidanceMessage" text="Analyse de votre parcours..." style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px;" wrapText="true"/>
            <HBox fx:id="recommendationBox" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false">
                <Label text="Prochaine étape suggérée :" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Button fx:id="btnNextChapter" text="Titre du Chapitre" style="-fx-background-color: white; -fx-text-fill: #6366f1; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20;" onAction="#onGoToRecommended"/>
            </HBox>
        </VBox>

        <HBox alignment="CENTER_LEFT" maxWidth="1000" spacing="20">
            <Label text="Liste des Cours" styleClass="card-title"/>
            <TextField fx:id="searchField" promptText="Rechercher un titre..." prefWidth="250" styleClass="text-field-modern" />
            <ComboBox fx:id="levelFilter" promptText="Tous les niveaux" prefWidth="180" styleClass="combo-box-modern" />
            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnNewCours" text="+ Nouveau Cours" styleClass="btn-primary" onAction="#onNewCours" />
        </HBox>

        <FlowPane fx:id="coursesContainer" hgap="20" vgap="20" maxWidth="900" alignment="TOP_LEFT" />
    </VBox>
</ScrollPane>
