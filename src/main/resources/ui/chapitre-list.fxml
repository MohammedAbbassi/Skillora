<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<VBox spacing="25" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ChapitreListController">
    <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>
    
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Mes Chapitres" styleClass="view-title"/>
            <Label text="Progressez à votre rythme à travers les chapitres." styleClass="card-subtitle"/>
        </VBox>
        <Button fx:id="btnAddChapitre" text="+ Ajouter un Chapitre" styleClass="btn-primary" onAction="#onAddChapitre" visible="false"/>
    </HBox>

    <!-- Course Selection & Search -->
    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="card">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Choisir un cours" styleClass="field-label"/>
            <ComboBox fx:id="courseSelector" promptText="Sélectionner un cours..." maxWidth="Infinity" styleClass="combo-box-modern"/>
        </VBox>
        <VBox spacing="8" prefWidth="300">
            <Label text="Rechercher" styleClass="field-label"/>
            <TextField fx:id="searchField" promptText="Rechercher un chapitre..." styleClass="text-field-modern"/>
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <FlowPane fx:id="chaptersContainer" hgap="25" vgap="25" style="-fx-padding: 10 0;">
            <!-- Chapter cards will be injected here -->
        </FlowPane>
    </ScrollPane>
</VBox>
