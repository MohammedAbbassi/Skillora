<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.web.WebView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<VBox spacing="0" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ChapitreDetailController">

    <!-- Header with progress -->
    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
        <Button text="← Retour" styleClass="btn-secondary" onAction="#onBack" />
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label fx:id="chapterTitleLabel" text="Titre du Chapitre" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ProgressBar fx:id="overallProgressBar" prefWidth="200" progress="0.4" styleClass="progress-bar-custom"/>
                <Label fx:id="progressTextLabel" text="40% Complété" styleClass="card-subtitle"/>
            </HBox>
        </VBox>
        <HBox spacing="10">
            <Button fx:id="btnPrev" text="Précédent" styleClass="nav-btn" onAction="#onPrev"/>
            <Button fx:id="btnNext" text="Suivant" styleClass="nav-btn" onAction="#onNext"/>
        </HBox>
    </HBox>

    <HBox VBox.vgrow="ALWAYS">
        <VBox HBox.hgrow="ALWAYS" alignment="TOP_CENTER">
            <!-- Supervisor / Attendance Bar (Advanced Profession) -->
            <HBox spacing="15" alignment="CENTER_LEFT" minHeight="50" prefHeight="50" style="-fx-background-color: linear-gradient(to right, #0f172a, #1e293b); -fx-padding: 8 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 2);">
                <Label text="👤 SUPERVISEUR" style="-fx-text-fill: #38bdf8; -fx-font-weight: 900; -fx-font-size: 11px; -fx-letter-spacing: 0.5px;"/>
                <Separator orientation="VERTICAL" prefHeight="15" style="-fx-opacity: 0.1;"/>
                
                <ToggleButton fx:id="btnPresence" text="Présence" onAction="#onTogglePresence" 
                              style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: #cbd5e1; -fx-background-radius: 20; -fx-padding: 4 15; -fx-cursor: hand; -fx-font-size: 11px;"/>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <HBox spacing="20" alignment="CENTER_RIGHT">
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="HEURE:" style="-fx-text-fill: #64748b; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="currentTimeLabel" text="--:--" style="-fx-text-fill: #f8fafc; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    </HBox>
                    <Separator orientation="VERTICAL" prefHeight="15" style="-fx-opacity: 0.1;"/>
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label text="SESSION:" style="-fx-text-fill: #64748b; -fx-font-size: 9px; -fx-font-weight: bold;"/>
                        <Label fx:id="sessionTimerLabel" text="00:00" style="-fx-text-fill: #38bdf8; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    </HBox>
                </HBox>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" fitToHeight="true" vbarPolicy="AS_NEEDED" style="-fx-background-color: #f8fafc; -fx-padding: 0;">
                    <VBox spacing="15" maxWidth="1000" alignment="TOP_CENTER" style="-fx-padding: 10 0 10 0;">
                        
                        <ImageView fx:id="chapterBannerImage" fitWidth="900" fitHeight="180" preserveRatio="true" visible="false" managed="false" 
                                   style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-background-radius: 10;">
                            <VBox.margin><Insets bottom="5"/></VBox.margin>
                        </ImageView>

                        <VBox spacing="15" maxWidth="900" styleClass="card">
                            <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
                            
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label fx:id="niveauLabel" text="MOYEN" styleClass="badge-moyen"/>
                                <Label fx:id="dureeLabel" text="15 min" styleClass="card-subtitle" style="-fx-font-weight: bold;"/>
                                <Region HBox.hgrow="ALWAYS" />
                                <ToggleButton fx:id="btnComplete" text="Terminer" styleClass="btn-secondary" onAction="#onToggleComplete" />
                                <Button fx:id="btnQuiz" text="Quiz" styleClass="btn-primary" visible="false" managed="false" onAction="#onQuizClick" />
                            </HBox>

                            <Separator />

                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="Contenu" styleClass="card-title" style="-fx-font-size: 18px;"/>
                                <Button text="🔊" onAction="#onPlayAudio" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 3 10;"/>
                                <Button fx:id="btnDyslexia" text="✨" onAction="#onToggleDyslexiaPanel" style="-fx-background-color: #f472b6; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 3 10;"/>
                            </HBox>

                            <StackPane fx:id="contentStack">
                                <TextArea fx:id="contenuArea" wrapText="true" editable="false" styleClass="text-area-modern" prefHeight="150" 
                                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 8; -fx-font-size: 13px;"/>
                                
                                <ScrollPane fx:id="dyslexiaScrollPane" visible="false" fitToWidth="true" styleClass="reader-container" style="-fx-background-color: white;">
                                    <javafx.scene.text.TextFlow fx:id="dyslexiaTextFlow" styleClass="reader-text" />
                                </ScrollPane>
                            </StackPane>

                            <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                                <Button text="PDF Chapitre" styleClass="btn-primary" style="-fx-font-size: 11px;" onAction="#onDownloadChapter" />
                                <Button text="PDF Cours" styleClass="btn-secondary" style="-fx-font-size: 11px;" onAction="#onReadPdf"/>
                                <Button fx:id="btnYoutube" text="🎬 YouTube" styleClass="btn-secondary" style="-fx-background-color: #fff1f2; -fx-text-fill: #e11d48; -fx-border-color: #fda4af; -fx-font-size: 11px;" onAction="#onOpenYoutube" visible="false" managed="false"/>
                            </HBox>
                        </VBox>

                        <HBox spacing="20" maxWidth="900" alignment="TOP_CENTER">
                            <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
                                <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
                                <Label text="Mes Remarques" styleClass="card-title" style="-fx-font-size: 16px;"/>
                                <TextArea fx:id="remarksArea" prefRowCount="3" promptText="Notes..." styleClass="text-area-modern" wrapText="true"/>
                                <Button text="Enregistrer" styleClass="btn-primary" onAction="#onSaveUserData" maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
                                <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
                                <Label text="Mes Travaux" styleClass="card-title" style="-fx-font-size: 16px;"/>
                                <ListView fx:id="tpFilesList" prefHeight="80" />
                                <HBox spacing="10">
                                    <Button text="+ Fichier" styleClass="btn-secondary" onAction="#onAddTp" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-font-size: 11px;"/>
                                    <Button text="Ouvrir" styleClass="btn-secondary" onAction="#onOpenTp" style="-fx-font-size: 11px;"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </ScrollPane>

                <!-- Settings Panel Overlay -->
                <HBox fx:id="dyslexiaPanelContainer" visible="false" alignment="CENTER_RIGHT" pickOnBounds="false">
                     <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                </HBox>
            </StackPane>
        </VBox>

        <!-- Learning Toolkit Sidebar (Dictionary + Tools) -->
        <VBox prefWidth="350" spacing="15" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 0 1; -fx-padding: 15;">
            
            <!-- Section 1: Dictionary (Minimized) -->
            <VBox spacing="8" prefHeight="200" style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-padding: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                <Label text="📖 Dictionnaire" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                <HBox spacing="5" alignment="CENTER_LEFT">
                    <TextField fx:id="dictSearchField" promptText="Mot..." style="-fx-font-size: 11px;" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#onManualSearch" text="🔍" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-font-size: 10px;"/>
                </HBox>
                
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" prefHeight="100">
                    <VBox fx:id="dictionaryContent" spacing="5">
                        <VBox fx:id="defEmptyState" alignment="CENTER" spacing="2">
                            <Label text="Sélectionnez un mot" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                        <VBox fx:id="defFoundState" visible="false" managed="false" spacing="5">
                            <HBox spacing="5" alignment="CENTER_LEFT">
                                <Label fx:id="defWordTitle" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#onClearDictionary" text="✕" style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-font-size: 10px;"/>
                            </HBox>
                            <VBox fx:id="definitionsContainer" spacing="3" />
                        </VBox>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- Section 2: Advanced Tools (Expanded) -->
            <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-padding: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 5, 0, 0, 0);">
                <Label text="🛠 Assistant de Rédaction" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
                
                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <Tab text="Orthographe">
                        <VBox spacing="12" style="-fx-padding: 15 0 0 0;">
                            <Label text="Analyse des remarques :" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                            <Label fx:id="spellCheckStatus" text="En attente d'analyse..." wrapText="true" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569; -fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 8;"/>
                            <HBox spacing="10">
                                <Button text="Analyser" onAction="#onCheckSpelling" styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Button fx:id="btnAutoCorrect" text="Corriger" onAction="#onAutoCorrect" styleClass="btn-primary" visible="false" managed="false"/>
                            </HBox>
                        </VBox>
                    </Tab>
                    <Tab text="Calculatrice">
                        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                            <TextField fx:id="calcDisplay" alignment="CENTER_RIGHT" editable="false" text="0" style="-fx-font-size: 18px; -fx-font-family: 'Courier New'; -fx-background-color: #f1f5f9;"/>
                            <GridPane hgap="5" vgap="5" alignment="CENTER">
                                <Button text="7" onAction="#onCalcDigit" prefWidth="45" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <Button text="8" onAction="#onCalcDigit" prefWidth="45" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Button text="9" onAction="#onCalcDigit" prefWidth="45" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <Button text="/" onAction="#onCalcOp" prefWidth="45" GridPane.rowIndex="0" GridPane.columnIndex="3" style="-fx-background-color: #e2e8f0;"/>
                                
                                <Button text="4" onAction="#onCalcDigit" prefWidth="45" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <Button text="5" onAction="#onCalcDigit" prefWidth="45" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Button text="6" onAction="#onCalcDigit" prefWidth="45" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                                <Button text="*" onAction="#onCalcOp" prefWidth="45" GridPane.rowIndex="1" GridPane.columnIndex="3" style="-fx-background-color: #e2e8f0;"/>
                                
                                <Button text="1" onAction="#onCalcDigit" prefWidth="45" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <Button text="2" onAction="#onCalcDigit" prefWidth="45" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                <Button text="3" onAction="#onCalcDigit" prefWidth="45" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                                <Button text="-" onAction="#onCalcOp" prefWidth="45" GridPane.rowIndex="2" GridPane.columnIndex="3" style="-fx-background-color: #e2e8f0;"/>
                                
                                <Button text="0" onAction="#onCalcDigit" prefWidth="45" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                <Button text="C" onAction="#onCalcClear" prefWidth="45" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: #ef4444;"/>
                                <Button text="=" onAction="#onCalcEquals" prefWidth="45" GridPane.rowIndex="3" GridPane.columnIndex="2" style="-fx-background-color: #3b82f6; -fx-text-fill: white;"/>
                                <Button text="+" onAction="#onCalcOp" prefWidth="45" GridPane.rowIndex="3" GridPane.columnIndex="3" style="-fx-background-color: #e2e8f0;"/>
                            </GridPane>
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>
        </VBox>
    </HBox>
</VBox>
