<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="30" alignment="TOP_CENTER" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.QuizController">

    <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>

    <HBox alignment="CENTER_LEFT">
        <Button text="← Retour" styleClass="btn-secondary" onAction="#onBack" />
    </HBox>

    <VBox spacing="20" alignment="CENTER" styleClass="card" maxWidth="800">
        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
        
        <Label fx:id="quizTitle" text="Quiz Final" styleClass="brand-title" style="-fx-font-size: 32px;"/>
        <Label text="Testez vos connaissances sur ce cours et obtenez votre badge de maîtrise !" styleClass="brand-subtitle" wrapText="true" alignment="CENTER"/>
        
        <Separator />
        
        <VBox spacing="30" style="-fx-padding: 20 0;">
            <Label text="Interface du Quiz en cours de préparation..." style="-fx-text-fill: #64748b; -fx-font-style: italic;"/>
            
            <Button text="Démarrer le Quiz" styleClass="btn-primary" prefWidth="250" prefHeight="50" style="-fx-font-size: 16px;"/>
        </VBox>
    </VBox>
</VBox>
