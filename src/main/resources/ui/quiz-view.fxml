<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="TOP_CENTER" stylesheets="@../theme.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.QuizController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <VBox maxWidth="900" prefHeight="700" styleClass="card" spacing="25" VBox.vgrow="ALWAYS">
        <padding><Insets top="30" right="45" bottom="30" left="45"/></padding>
        
        <HBox alignment="CENTER_LEFT" spacing="20">
            <VBox>
                <Label text="Quiz Interactif" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                <Label fx:id="progressLabel" text="Question 1 sur 10" style="-fx-font-size: 16px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Abandonner" styleClass="btn-secondary" onAction="#onQuit"/>
        </HBox>
        
        <ProgressBar fx:id="quizProgressBar" progress="0.1" maxWidth="Infinity" prefHeight="10" style="-fx-accent: #3b82f6;"/>
        
        <Separator />
        
        <VBox fx:id="questionArea" spacing="30" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label fx:id="questionTitle" text="Chargement de la question..." wrapText="true" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
            
            <VBox fx:id="optionsContainer" spacing="20">
                <!-- Les RadioButtons seront ajoutés ici dynamiquement -->
            </VBox>
        </VBox>
        
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
            <Button fx:id="btnNext" text="Question Suivante →" styleClass="btn-primary" onAction="#onNext" prefWidth="300" prefHeight="55" style="-fx-background-color: #3b82f6; -fx-font-size: 18px;"/>
            <Button fx:id="btnSubmit" text="Terminer et Soumettre" styleClass="btn-primary" onAction="#onValidate" prefWidth="300" prefHeight="55" style="-fx-background-color: #10b981;" visible="false" managed="false"/>
        </HBox>

        <VBox fx:id="resultBox" spacing="15" alignment="CENTER" visible="false" managed="false" style="-fx-background-color: #f0fdf4; -fx-padding: 40; -fx-background-radius: 15; -fx-border-color: #bbf7d0; -fx-border-width: 2;">
            <Label text="✨ Parfait ! Vous avez terminé ✨" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
            <Label fx:id="scoreLabel" text="Score : 0/0" style="-fx-font-size: 45px; -fx-font-weight: 900; -fx-text-fill: #16a34a;"/>
            <Label fx:id="percentageLabel" text="Réussite : 0%" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #166534;"/>
            <Button text="Retour au chapitre" styleClass="btn-primary" onAction="#onQuit" style="-fx-background-color: #16a34a; -fx-margin-top: 25; -fx-padding: 15 40;"/>

        </VBox>

        <HBox alignment="CENTER" style="-fx-padding: 15 0 0 0;">
            <Label text="🚀 Données fournies par Open Trivia DB API" style="-fx-font-size: 13px; -fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>
</VBox>
