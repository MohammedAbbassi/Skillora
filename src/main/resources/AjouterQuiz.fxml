<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="22" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AjouterQuiz">
    <padding>
        <Insets top="34" right="40" bottom="34" left="40"/>
    </padding>

    <VBox spacing="6">
        <Label fx:id="screenTitleLabel" text="Ajouter un quiz" styleClass="page-title"/>
        <Label text="Renseignez les informations du quiz dans l'ordre demandé." styleClass="page-subtitle"/>
    </VBox>

    <VBox spacing="18" maxWidth="760" styleClass="form-card">
        <VBox spacing="8">
            <Label text="Nom du quiz" styleClass="field-label"/>
            <TextField fx:id="nomQuizTextField" promptText="Exemple : Fondamentaux Java"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Matière" styleClass="field-label"/>
            <ComboBox fx:id="matiereCombo" maxWidth="Infinity" promptText="Sélectionner une matière"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Niveau" styleClass="field-label"/>
            <ComboBox fx:id="niveauCombo" maxWidth="Infinity" promptText="Sélectionner un niveau"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Description" styleClass="field-label"/>
            <TextArea fx:id="descriptionTextArea" prefRowCount="5" promptText="Décrivez ce que ce quiz évalue."/>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button minWidth="116" text="Annuler" onAction="#cancel" styleClass="ghost-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="submitButton" minWidth="176" text="Suivant : Question" onAction="#next" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
