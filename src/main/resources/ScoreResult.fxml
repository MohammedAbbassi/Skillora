<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="22" alignment="CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ScoreResultController">
    <padding>
        <Insets top="60" right="40" bottom="60" left="40"/>
    </padding>

    <VBox spacing="10" alignment="CENTER" maxWidth="520" styleClass="form-card">
        <Label text="Score final" styleClass="page-title"/>
        <Label fx:id="scoreLabel" text="0 / 0" styleClass="metric-value"/>
        <Label fx:id="messageLabel" text="Resultat enregistre." wrapText="true" styleClass="page-subtitle"/>
        <HBox alignment="CENTER" spacing="12">
            <Button minWidth="178" text="Exporter les resultats" onAction="#exportResultsPdf" styleClass="secondary-button"/>
            <Button minWidth="160" text="Retour" onAction="#retourQuiz" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
