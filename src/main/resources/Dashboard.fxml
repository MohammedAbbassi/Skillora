<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>

<VBox spacing="24" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.DashboardController">
    <padding>
        <Insets top="34" right="40" bottom="34" left="40"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="6">
            <Label text="Tableau de bord" styleClass="page-title"/>
            <Label text="Vue d'ensemble du contenu et du parcours de création." styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="142" text="Nouveau Quiz" onAction="#createQuiz" styleClass="primary-button"/>
    </HBox>

    <HBox spacing="18">
        <VBox spacing="8" styleClass="metric-card">
            <Label text="Quiz" styleClass="metric-label"/>
            <Label fx:id="quizCountLabel" text="0" styleClass="metric-value"/>
        </VBox>
        <VBox spacing="8" styleClass="metric-card">
            <Label text="Questions" styleClass="metric-label"/>
            <Label fx:id="questionCountLabel" text="0" styleClass="metric-value"/>
        </VBox>
        <VBox spacing="8" styleClass="metric-card">
            <Label text="Réponses" styleClass="metric-label"/>
            <Label fx:id="answerCountLabel" text="0" styleClass="metric-value"/>
        </VBox>
    </HBox>

    <VBox spacing="14" styleClass="dashboard-journey-card">
        <Label text="Parcours de création" styleClass="dashboard-journey-title"/>
        <FlowPane hgap="18" vgap="18">
            <HBox spacing="16" styleClass="dashboard-journey-step">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="01" styleClass="dashboard-journey-number"/>
                    <Label text="Créer le quiz" styleClass="dashboard-journey-step-title"/>
                    <Label text="Définir la matière, le niveau et la description." wrapText="true" styleClass="dashboard-journey-step-desc"/>
                </VBox>
                <javafx.scene.image.ImageView fitWidth="160" fitHeight="120" preserveRatio="true" styleClass="dashboard-step-illustration">
                    <image>
                        <javafx.scene.image.Image url="@images/step_quiz.png"/>
                    </image>
                </javafx.scene.image.ImageView>
            </HBox>

            <HBox spacing="16" styleClass="dashboard-journey-step">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="02" styleClass="dashboard-journey-number"/>
                    <Label text="Ajouter une question" styleClass="dashboard-journey-step-title"/>
                    <Label text="Choisir QCU ou QCM." wrapText="true" styleClass="dashboard-journey-step-desc"/>
                </VBox>
                <javafx.scene.image.ImageView fitWidth="160" fitHeight="120" preserveRatio="true" styleClass="dashboard-step-illustration">
                    <image>
                        <javafx.scene.image.Image url="@images/step_question.png"/>
                    </image>
                </javafx.scene.image.ImageView>
            </HBox>

            <HBox spacing="16" styleClass="dashboard-journey-step">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <Label text="03" styleClass="dashboard-journey-number"/>
                    <Label text="Ajouter les réponses" styleClass="dashboard-journey-step-title"/>
                    <Label text="Appliquer les règles selon le type." wrapText="true" styleClass="dashboard-journey-step-desc"/>
                </VBox>
                <javafx.scene.image.ImageView fitWidth="160" fitHeight="120" preserveRatio="true" styleClass="dashboard-step-illustration">
                    <image>
                        <javafx.scene.image.Image url="@images/step_reponse.png"/>
                    </image>
                </javafx.scene.image.ImageView>
            </HBox>
        </FlowPane>
    </VBox>
</VBox>
