<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.QuizHistoryController">
    <padding>
        <Insets top="34" right="40" bottom="34" left="40"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="14">
        <VBox spacing="6">
            <Label text="Historique des passages" styleClass="page-title"/>
            <Label text="Resultats enregistres, scores et incidents anti-triche." wrapText="true" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button minWidth="154" text="Exporter le PDF" onAction="#exportSelectedResult" styleClass="secondary-button"/>
        <Button minWidth="118" text="Actualiser" onAction="#refreshHistory" styleClass="primary-button"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchField" promptText="Rechercher utilisateur ou quiz" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="antiCheatFilterCombo" prefWidth="210"/>
        <Label fx:id="searchCountLabel" text="0 passage(s)" styleClass="page-subtitle"/>
    </HBox>

    <VBox spacing="12" styleClass="table-panel" VBox.vgrow="ALWAYS">
        <Label text="Passages de quiz" styleClass="section-title"/>
        <ListView fx:id="resultList" minHeight="420" prefHeight="560" VBox.vgrow="ALWAYS"
                  styleClass="cards-list"/>
    </VBox>
</VBox>
