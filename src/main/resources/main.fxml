<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" prefHeight="700.0" prefWidth="1000.0" styleClass="bg-base" stylesheets="/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginController">
   <children>
      <!-- Decorative Background Elements -->
      <StackPane mouseTransparent="true">
         <children>
            <Circle fx:id="orb1" fill="#4a90e2" opacity="0.1" radius="250.0" StackPane.alignment="TOP_LEFT">
               <StackPane.margin>
                  <Insets left="-100.0" top="-100.0" />
               </StackPane.margin>
            </Circle>
            <Circle fx:id="orb2" fill="#4a90e2" opacity="0.1" radius="200.0" StackPane.alignment="BOTTOM_RIGHT">
               <StackPane.margin>
                  <Insets bottom="-80.0" right="-80.0" />
               </StackPane.margin>
            </Circle>
         </children>
      </StackPane>

      <!-- Main Auth Card -->
      <VBox fx:id="formCard" alignment="CENTER" fillWidth="false" maxWidth="420.0" spacing="0.0" styleClass="form-card">
         <children>
            <!-- Logo Area -->
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <StackPane fx:id="logoRing" maxHeight="60.0" maxWidth="60.0" prefHeight="60.0" prefWidth="60.0">
                     <children>
                        <Circle fx:id="logoCircle" fill="TRANSPARENT" radius="28.0" stroke="#4a90e2" strokeWidth="2.0" />
                        <Label fx:id="logoIcon" styleClass="logo-icon" text="S" />
                     </children>
                  </StackPane>
                  <Label fx:id="titleLabel" styleClass="title-label" text="Welcome Back" />
                  <Label fx:id="subtitleLabel" styleClass="subtitle-label" text="Please enter your details to sign in" />
               </children>
               <VBox.margin>
                  <Insets bottom="30.0" />
               </VBox.margin>
            </VBox>

            <!-- Form Fields Container -->
            <VBox prefWidth="340.0" spacing="15.0">
               <children>
                  <!-- Username Field (Hidden by default) -->
                  <VBox fx:id="nameFieldBox" managed="false" spacing="8.0" visible="false">
                     <children>
                        <Label styleClass="field-label" text="Full Name" />
                        <TextField fx:id="nameField" promptText="Enter your name" styleClass="auth-field" />
                     </children>
                  </VBox>

                  <!-- Email Field -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="field-label" text="Email Address" />
                        <TextField fx:id="emailField" promptText="name@company.com" styleClass="auth-field" />
                     </children>
                  </VBox>

                  <!-- Password Field -->
                  <VBox spacing="8.0">
                     <children>
                        <Label styleClass="field-label" text="Password" />
                        <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="auth-field" />
                        <HBox alignment="CENTER_RIGHT">
                           <children>
                              <Label fx:id="forgotLabel" onMouseClicked="#onForgotPassword" styleClass="link-label" text="Forgot password?" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <VBox fx:id="confirmPasswordBox" managed="false" spacing="8.0" visible="false">
                     <children>
                        <Label styleClass="field-label" text="Confirm Password" />
                        <PasswordField fx:id="confirmPasswordField" promptText="••••••••" styleClass="auth-field" />
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- Action Area -->
            <VBox alignment="CENTER" prefWidth="340.0" spacing="20.0">
               <children>
                  <Button fx:id="actionButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onActionButton" styleClass="action-btn" text="Sign In" />
                  <HBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label fx:id="toggleLabel" styleClass="toggle-label" text="Don't have an account?" />
                        <Label fx:id="toggleLink" onMouseClicked="#onToggleMode" styleClass="toggle-link" text="Sign up" />
                     </children>
                  </HBox>
               </children>
               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>
            </VBox>
         </children>
         <padding>
            <Insets bottom="50.0" left="40.0" right="40.0" top="50.0" />
         </padding>
      </VBox>
   </children>
</StackPane>
