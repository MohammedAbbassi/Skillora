<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="22" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AjouterQuestion">
    <padding>
        <Insets top="34" right="40" bottom="34" left="40"/>
    </padding>

    <VBox spacing="6">
        <Label fx:id="screenTitleLabel" text="Modifier une question" styleClass="page-title"/>
        <Label text="Modifiez l'énoncé ou le type de la question." styleClass="page-subtitle"/>
    </VBox>

    <VBox spacing="18" maxWidth="760" styleClass="form-card">
        <VBox spacing="8">
            <Label text="Énoncé de la question" styleClass="field-label"/>
            <TextArea fx:id="enonceTextArea" prefRowCount="7"/>
        </VBox>
        <VBox spacing="8">
            <Label text="Type de question" styleClass="field-label"/>
            <ComboBox fx:id="typeQuestionCombo" maxWidth="Infinity"/>
        </VBox>
        <VBox spacing="8">
            <Label styleClass="field-label" text="Image illustrative (Optionnel)" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button minWidth="120" onAction="#uploadImage" styleClass="secondary-button" text="Choisir une image" />
                <Button fx:id="removeImageBtn" onAction="#removeImage" styleClass="danger-button" text="Supprimer" visible="false" managed="false" />
            </HBox>
            <javafx.scene.image.ImageView fx:id="questionImageView" fitWidth="300" fitHeight="200" preserveRatio="true"/>
            <Label fx:id="imagePathLabel" styleClass="muted-text" text="" />
        </VBox>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button minWidth="116" text="Annuler" onAction="#cancel" styleClass="ghost-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button minWidth="132" text="Enregistrer" onAction="#next" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
