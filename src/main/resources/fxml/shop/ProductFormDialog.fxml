<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.skillora.shop.controllers.ProductFormDialogController"
      prefWidth="760"
      maxWidth="760"
      spacing="0"
      stylesheets="@../../css/theme.css">
    <VBox spacing="18" styleClass="product-dialog">
        <HBox spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="dialogTitle" text="Details du produit" styleClass="title-h2"/>
                <Label text="Veuillez renseigner les informations ci-dessous." styleClass="muted"/>
            </VBox>
            <Label text="Produit" styleClass="course-badge"/>
        </HBox>

        <Separator/>

        <GridPane hgap="18" vgap="14">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            </columnConstraints>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                <Label text="Nom du produit" styleClass="field-label"/>
                <TextField fx:id="fieldNom" promptText="Ex: Formation Java avancee" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                <Label text="Description" styleClass="field-label"/>
                <TextArea fx:id="fieldDesc" prefRowCount="4" wrapText="true" promptText="Decrivez brievement le produit..." maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label text="Prix (TND)" styleClass="field-label"/>
                <TextField fx:id="fieldPrix" promptText="0.00" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label text="Langue" styleClass="field-label"/>
                <TextField fx:id="fieldLangue" promptText="Ex: Francais" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <Label text="Categorie" styleClass="field-label"/>
                <ComboBox fx:id="comboCategorie" maxWidth="Infinity"/>
            </VBox>

            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Label text="Niveau" styleClass="field-label"/>
                <ComboBox fx:id="comboNiveau" maxWidth="Infinity"/>
            </VBox>
        </GridPane>

        <Separator/>

        <VBox spacing="10">
            <Label text="Image du produit" styleClass="field-label"/>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <StackPane styleClass="product-image-picker" prefWidth="128" prefHeight="128" minWidth="128" minHeight="128">
                    <Label fx:id="imagePlaceholder" text="Image" styleClass="muted"/>
                    <ImageView fx:id="imagePreview" fitWidth="124" fitHeight="124" preserveRatio="true"/>
                </StackPane>
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <TextField fx:id="fieldImagePath" promptText="URL de l'image ou chemin local" editable="false" maxWidth="Infinity"/>
                    <HBox spacing="10">
                        <Button text="Choisir un fichier" onAction="#onBrowseImage" styleClass="secondary-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Generer par IA" onAction="#onGenerateAIImage" styleClass="secondary-button accent-text" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Label text="L'IA generera une image basee sur le nom et la description du produit." styleClass="muted" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>

        <Separator/>

        <HBox spacing="14" alignment="CENTER_RIGHT">
            <Label fx:id="errorMsg" styleClass="danger-text" wrapText="true" visible="false" managed="false" HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Annuler" onAction="#onCancel" styleClass="secondary-button" minWidth="110"/>
            <Button fx:id="btnConfirm" text="Enregistrer" defaultButton="true" onAction="#onConfirm" styleClass="primary-button" minWidth="150"/>
        </HBox>
    </VBox>
</VBox>
