<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.skillora.payment.PaymentController" spacing="25"
      stylesheets="@../../css/theme.css" prefWidth="450" style="-fx-background-color: white;">
    <padding>
        <Insets bottom="30" left="30" right="30" top="30"/>
    </padding>

    <VBox spacing="10" alignment="CENTER">
        <Label text="Paiement Stripe" styleClass="title-h2" style="-fx-text-fill: #635bff;"/>
        <Label text="Conversion temps réel TND ➔ USD" styleClass="muted"/>
    </VBox>

    <Separator/>

    <VBox spacing="15" styleClass="card" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 15;">
        <HBox alignment="CENTER_LEFT">
            <Label text="Récapitulatif" style="-fx-font-weight: bold; -fx-text-fill: #64748b;"/>
        </HBox>
        
        <HBox alignment="CENTER_LEFT">
            <Label text="Montant (TND) :" styleClass="field-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="amountLabel" text="0.00 TND" style="-fx-font-size: 14px;"/>
        </HBox>

        <HBox alignment="CENTER_LEFT">
            <Label text="Montant à payer (USD) :" styleClass="field-label" style="-fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="convertedAmountLabel" text="..." style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #635bff;"/>
        </HBox>
        
        <HBox alignment="CENTER_LEFT">
            <Label text="Commande N° :" styleClass="field-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="orderIdLabel" text="#000" style="-fx-font-family: 'Courier New';"/>
        </HBox>
    </VBox>

    <VBox fx:id="statusContainer" spacing="10" alignment="CENTER" visible="false" managed="false">
        <ProgressIndicator fx:id="loadingIndicator" prefHeight="40" prefWidth="40"/>
        <Label fx:id="statusLabel" text="Initialisation Stripe..." style="-fx-text-fill: #635bff;"/>
    </VBox>

    <VBox spacing="15">
        <Button fx:id="payButton" text="Payer avec Stripe 💳" onAction="#onPay" 
                styleClass="primary-button" prefWidth="Infinity" prefHeight="50" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-background-color: #635bff;"/>
        
        <Button fx:id="verifyButton" text="Vérifier le statut ✅" onAction="#onVerify" 
                styleClass="secondary-button" prefWidth="Infinity" prefHeight="40" visible="false" managed="false"/>
        
        <Button fx:id="cancelButton" text="Annuler" onAction="#onCancel" 
                styleClass="secondary-button" prefWidth="Infinity" prefHeight="40"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="danger-text" wrapText="true" alignment="CENTER" prefWidth="Infinity" visible="false" managed="false"/>
</VBox>
