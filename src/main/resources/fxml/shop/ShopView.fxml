<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.skillora.controllers.ShopController" stylesheets="@../../css/theme.css">
    <padding>
        <Insets bottom="8" left="8" right="8" top="8"/>
    </padding>
    <center>
        <VBox spacing="12">
            <Label text="Boutique" styleClass="title-h2"/>
            <Label text="Statistiques du catalogue et produits en cartes — filtrez par catégorie puis ajoutez au panier." styleClass="muted"/>
            <HBox spacing="10" styleClass="stat-strip">
                <VBox styleClass="stat-card" spacing="4">
                    <Label text="Produits" styleClass="stat-label"/>
                    <Label fx:id="statTotalProducts" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="4">
                    <Label text="Prix moyen (TND)" styleClass="stat-label"/>
                    <Label fx:id="statAvgPrice" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="4">
                    <Label text="Min / Max (TND)" styleClass="stat-label"/>
                    <Label fx:id="statMinMax" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" spacing="4">
                    <Label text="Par catégorie" styleClass="stat-label"/>
                    <Label fx:id="statByType" wrapText="true" styleClass="muted"/>
                </VBox>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Filtrer :" styleClass="field-label"/>
                <ComboBox fx:id="filterTypeCombo" prefWidth="200" promptText="Tous les types"/>
                <Label text="Trier par :" styleClass="field-label" style="-fx-padding: 0 0 0 10;"/>
                <ComboBox fx:id="sortCombo" prefWidth="220" promptText="Trier par nom"/>
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="catalog-scroll" prefHeight="380" VBox.vgrow="ALWAYS">
                <FlowPane fx:id="productsFlow" hgap="14" vgap="14" prefWrapLength="900"/>
            </ScrollPane>
        </VBox>
    </center>
    <right>
        <VBox spacing="12" prefWidth="280" styleClass="card">
            <padding>
                <Insets bottom="16" left="16" right="16" top="16"/>
            </padding>
            <Label text="Panier" styleClass="title-h2"/>
            <ListView fx:id="cartList" prefHeight="280"/>
            <!-- Coupons -->
            <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-width: 1;">
                <Label text="CODE PROMO" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                <HBox spacing="8">
                    <TextField fx:id="couponField" promptText="Entrez votre code" HBox.hgrow="ALWAYS" prefHeight="35"/>
                    <Button text="Appliquer" onAction="#onApplyCoupon" styleClass="secondary-button" prefHeight="35"/>
                </HBox>
                <Label fx:id="couponStatusMsg" style="-fx-font-size: 11px;" wrapText="true" visible="false" managed="false"/>
            </VBox>

            <Separator/>

            <VBox spacing="10">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Total produits :" styleClass="muted"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="subtotalLabel" text="0.00 TND" style="-fx-font-weight: bold;"/>
                </HBox>
                <HBox fx:id="discountRow" alignment="CENTER_LEFT" visible="false" managed="false">
                    <Label text="Réduction :" style="-fx-text-fill: #ef4444;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="discountLabel" text="-0.00 TND" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="TOTAL À PAYER :" styleClass="title-h3"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalLabel" text="0.00 TND" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: #4f46e5;"/>
                </HBox>
            </VBox>
            <HBox spacing="8">
                <Button text="Retirer sélection" onAction="#onRemoveLine" styleClass="secondary-button"
                        maxWidth="Infinity"/>
            </HBox>
            <Button text="Valider la commande" onAction="#onCheckout" styleClass="primary-button"
                    maxWidth="Infinity"/>
            <Label fx:id="shopMessage" wrapText="true" styleClass="muted"/>
        </VBox>
    </right>
</BorderPane>
