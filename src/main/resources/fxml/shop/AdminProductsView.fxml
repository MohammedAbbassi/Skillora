<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AdminProductsController" spacing="24"
      stylesheets="/styles.css" styleClass="content-area">
    <padding>
        <Insets bottom="24" left="24" right="24" top="24"/>
    </padding>
    
    <VBox spacing="4">
        <Label text="Gestion des Produits" styleClass="section-title"/>
        <Label text="Ajoutez ou modifiez les articles de la boutique." styleClass="text-secondary"/>
    </VBox>

    <VBox spacing="12" styleClass="card">
        <TableView fx:id="productTable" prefHeight="250">
            <columns>
                <TableColumn fx:id="colId" text="Id" prefWidth="50"/>
                <TableColumn fx:id="colNom" text="Nom" prefWidth="200"/>
                <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="110"/>
                <TableColumn fx:id="colLangue" text="Langue" prefWidth="80"/>
                <TableColumn fx:id="colPrix" text="Prix" prefWidth="90"/>
                <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="110"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="20" styleClass="card">
        <Label text="Détails du Produit" styleClass="card-title"/>
        <GridPane hgap="20" vgap="16">
            <columnConstraints>
                <ColumnConstraints minWidth="120"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
                <ColumnConstraints minWidth="120"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
            </columnConstraints>
            
            <Label text="Nom" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="fieldNom" styleClass="auth-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            
            <Label text="Prix (TND)" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="fieldPrix" promptText="0.00" styleClass="auth-field" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            
            <Label text="Catégorie" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="comboCategorie" prefWidth="1.7976931348623157E308" styleClass="auth-field" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            
            <Label text="Niveau" styleClass="field-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <ComboBox fx:id="comboNiveau" prefWidth="1.7976931348623157E308" styleClass="auth-field" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            
            <Label text="Langue" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="fieldLangue" promptText="FR" styleClass="auth-field" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            
            <Label text="Description" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextArea fx:id="fieldDesc" prefRowCount="2" wrapText="true" styleClass="auth-field" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="3"/>
        </GridPane>
        
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button text="Vider" onAction="#onClearForm" styleClass="action-btn-secondary"/>
            <Button text="Supprimer" onAction="#onDelete" styleClass="action-btn-secondary" style="-fx-text-fill: #ef4444;"/>
            <Button text="Mettre à jour" onAction="#onUpdate" styleClass="action-btn-secondary"/>
            <Button text="Ajouter Produit" onAction="#onAdd" styleClass="action-btn" prefWidth="180"/>
        </HBox>
    </VBox>
    
    <Label fx:id="adminMsg" styleClass="text-secondary" wrapText="true"/>
</VBox>
