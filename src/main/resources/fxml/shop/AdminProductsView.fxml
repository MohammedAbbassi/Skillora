<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.skillora.shop.controllers.AdminProductsController" spacing="12"
      stylesheets="@../../css/theme.css">
    <padding>
        <Insets bottom="8" left="8" right="8" top="8"/>
    </padding>
    <VBox spacing="25" styleClass="card" VBox.vgrow="ALWAYS">
        <HBox spacing="15" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Gestion du Catalogue" styleClass="title-h1"/>
                <Label text="Consultez, ajoutez et gérez tous les produits de la plateforme." styleClass="muted"/>
            </VBox>
            <Button text="+ Ajouter un Produit" onAction="#onAdd" styleClass="primary-button" prefHeight="45">
                <style>-fx-font-size: 14px; -fx-padding: 0 25;</style>
            </Button>
        </HBox>
        
        <Separator/>

        <VBox spacing="15" VBox.vgrow="ALWAYS">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="text-field" HBox.hgrow="ALWAYS" maxWidth="400" prefHeight="40">
                    <Label text="🔍" style="-fx-opacity: 0.5;"/>
                    <TextField fx:id="searchField" promptText="Rechercher un produit..." style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 0;" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10">
                    <Button fx:id="btnEdit" text="Modifier" onAction="#onEdit" styleClass="secondary-button" disable="true" prefHeight="40">
                        <graphic><Label text="✏️"/></graphic>
                    </Button>
                    <Button fx:id="btnDelete" text="Supprimer" onAction="#onDelete" styleClass="danger-button" disable="true" prefHeight="40">
                        <graphic><Label text="🗑️"/></graphic>
                    </Button>
                </HBox>
            </HBox>
            
            <ListView fx:id="productList" VBox.vgrow="ALWAYS" style="-fx-background-radius: 12; -fx-border-radius: 12;"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-width: 1;">
            <Label text="💡" style="-fx-font-size: 16px;"/>
            <Label fx:id="adminMsg" text="Sélectionnez un produit pour le modifier ou le supprimer." styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>



    <Label fx:id="adminMsg" styleClass="muted" wrapText="true"/>
</VBox>
