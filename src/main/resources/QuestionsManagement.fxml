<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.QuestionsManagementController">
    <padding>
        <Insets bottom="34" left="40" right="40" top="34" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="14">
        <VBox spacing="6">
            <Label styleClass="page-title" text="Questions" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button minWidth="158" onAction="#addAnswers" styleClass="secondary-button" text="Ajouter Réponses" />
        <Button minWidth="118" onAction="#editQuestion" styleClass="secondary-button" text="Modifier" />
        <Button minWidth="118" onAction="#deleteQuestion" styleClass="danger-button" text="Supprimer" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="searchQuestionField" promptText="Rechercher une question..." HBox.hgrow="ALWAYS" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="searchCountLabel" text="0 résultat(s)" styleClass="page-subtitle" />
    </HBox>

    <VBox spacing="12" styleClass="table-panel" VBox.vgrow="ALWAYS">
        <Label styleClass="section-title" text="Liste des questions" />
        <ListView fx:id="questionList" VBox.vgrow="ALWAYS" styleClass="cards-list" />
    </VBox>
</VBox>
