<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="22" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AjouterQuestion">
    <padding>
        <Insets bottom="34" left="40" right="40" top="34" />
    </padding>

    <VBox spacing="6">
        <Label fx:id="screenTitleLabel" styleClass="page-title" text="Ajouter une question" />
        <Label styleClass="page-subtitle" />
    </VBox>

    <VBox maxWidth="760" spacing="18" styleClass="form-card">
        <VBox spacing="8">
            <Label styleClass="field-label" text="Énoncé de la question" />
            <TextArea fx:id="enonceTextArea" prefRowCount="7" promptText="Rédigez un énoncé clair." />
        </VBox>
        <VBox spacing="8">
            <Label styleClass="field-label" text="Type de question" />
            <ComboBox fx:id="typeQuestionCombo" maxWidth="Infinity" promptText="Choisir QCU / QCM " />
        </VBox>
        <VBox spacing="8">
            <Label styleClass="field-label" text="Image illustrative (Optionnel)" />
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button minWidth="120" onAction="#uploadImage" styleClass="secondary-button" text="Choisir une image" />
                <Button fx:id="removeImageBtn" onAction="#removeImage" styleClass="danger-button" text="Supprimer" visible="false" managed="false" />
            </HBox>
            <javafx.scene.image.ImageView fx:id="questionImageView" fitWidth="300" fitHeight="200" preserveRatio="true"/>
            <Label fx:id="imagePathLabel" styleClass="muted-text" text="" />
        </VBox>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button minWidth="116" onAction="#cancel" styleClass="ghost-button" text="Annuler" />
            <Button minWidth="158" onAction="#generateWithAi" styleClass="ai-button" text="Generer avec IA" />
            <Region HBox.hgrow="ALWAYS" />
            <Button minWidth="184" onAction="#next" styleClass="primary-button" text="Suivant : Réponses" />
        </HBox>
    </VBox>
</VBox>
