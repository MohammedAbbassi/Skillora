<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane" prefHeight="700" prefWidth="1000" styleClass="login-full-root" stylesheets="/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginController">
    
    <!-- Background Glows -->
    <children>
        <StackPane mouseTransparent="true">
            <children>
                <Circle fill="#4F46E5" radius="300.0" opacity="0.1" StackPane.alignment="TOP_LEFT">
                    <StackPane.margin><Insets left="-150" top="-150" /></StackPane.margin>
                </Circle>
                <Circle fill="#7C3AED" radius="250.0" opacity="0.1" StackPane.alignment="BOTTOM_RIGHT">
                    <StackPane.margin><Insets right="-100" bottom="-100" /></StackPane.margin>
                </Circle>
            </children>
        </StackPane>


        <!-- Centered Login Card -->
        <VBox alignment="CENTER" spacing="0">
            <VBox fx:id="loginCard" alignment="TOP_CENTER" maxWidth="450" styleClass="login-card-premium">
                <padding><Insets bottom="50" left="50" right="50" top="50" /></padding>
                
                <StackPane styleClass="login-logo-holder">
                    <Label styleClass="login-logo-mark-small" text="S" />
                </StackPane>
                
                <Label styleClass="form-title-premium" text="Welcome to Skillora">
                    <VBox.margin><Insets top="20" /></VBox.margin>
                </Label>
                <Label fx:id="formSubtitle" styleClass="form-subtitle-premium" text="Enter your credentials to continue your quest" />
                
                <VBox spacing="20" maxWidth="350">
                    <VBox.margin><Insets top="35" /></VBox.margin>
                    
                    <!-- Register-only: Name field -->
                    <VBox fx:id="nameFieldBox" managed="false" spacing="8" visible="false">
                        <Label styleClass="field-label-premium" text="FULL NAME" />
                        <TextField fx:id="nameField" promptText="Your hero name" styleClass="auth-input-premium" />
                    </VBox>

                    <!-- Email -->
                    <VBox spacing="8">
                        <Label styleClass="field-label-premium" text="EMAIL ADDRESS" />
                        <TextField fx:id="emailField" promptText="you@example.com" styleClass="auth-input-premium" />
                    </VBox>

                    <!-- Password -->
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="field-label-premium" text="PASSWORD" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="forgotLabel" onMouseClicked="#onForgotPassword" styleClass="link-label-premium" text="Forgot?" />
                        </HBox>
                        <PasswordField fx:id="passwordField" promptText="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;" styleClass="auth-input-premium" />
                    </VBox>

                    <!-- Error message -->
                    <Label fx:id="errorLabel" managed="false" styleClass="error-label-premium" text="" visible="false" wrapText="true" />

                    <!-- Action button -->
                    <Button fx:id="actionBtn" maxWidth="Infinity" onAction="#onActionButton" styleClass="auth-btn-premium" text="SIGN IN" />

                    <!-- Toggle mode -->
                    <HBox alignment="CENTER" spacing="6">
                        <Label fx:id="toggleLabel" styleClass="toggle-label-premium" text="New to the quest?" />
                        <Label fx:id="toggleLink" onMouseClicked="#onToggleMode" styleClass="toggle-link-premium" text="Create Account" />
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
        <!-- Close Button (Custom) -->
        <VBox alignment="TOP_RIGHT" pickOnBounds="false">
            <padding><Insets right="20" top="20" /></padding>
            <Button onAction="#onCloseApp" styleClass="close-btn" text="&#x2715;" />
        </VBox>
    </children>
</StackPane>
