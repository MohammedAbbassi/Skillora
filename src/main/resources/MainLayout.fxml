                        <Label fx:id="chatHeader" styleClass="text-sm font-bold text-slate-800" text="Chat" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="✕" onAction="#onCloseChat" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;" />
                    </HBox>
                    <ScrollPane fx:id="chatScroll" fitToWidth="true" prefHeight="200" style="-fx-background: transparent; -fx-background-color: transparent;">
                        <VBox fx:id="chatMessages" spacing="8" />
                    </ScrollPane>
                    <HBox spacing="8.0">
                        <TextField fx:id="chatInput" promptText="Message..." HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-padding: 6;" onAction="#onSendChat" />
                        <Button text="Send" onAction="#onSendChat" styleClass="primary-btn" style="-fx-padding: 6 12; -fx-font-size: 11px;" />
                    </HBox>
                </VBox>
            </children>
        </VBox>
    </right>
        </BorderPane>
    </children>
</StackPane>
