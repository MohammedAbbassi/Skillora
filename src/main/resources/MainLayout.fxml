<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.*?>

<!--
    MainLayout.fxml - Skillora App Shell
    RESTORED HIGH QUALITY VERSION
    100% ASCII-safe for IBM437 environment.
-->

<StackPane fx:id="rootPane" prefHeight="800.0" prefWidth="1280.0" styleClass="app-root" stylesheets="/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.MainController">
    <children>
        <BorderPane fx:id="mainShell" styleClass="main-shell">
            <top>
                <StackPane fx:id="topStack" prefHeight="80.0">
                    <children>
                        <HBox fx:id="topbar" alignment="CENTER_LEFT" prefHeight="80.0" spacing="24.0" styleClass="topbar">
                            <children>
                                <Label fx:id="topbarLogoText" styleClass="text-xl font-black text-slate-800" text="Player Dashboard" />
                                <Region HBox.hgrow="ALWAYS" />
                                
                                <HBox alignment="CENTER" spacing="28.0" style="-fx-border-color: #e2e8f0; -fx-border-width: 0 1 0 0; -fx-padding: 0 24 0 0;">
                                    <HBox alignment="CENTER" spacing="10.0">
                                        <StackPane maxHeight="32.0" maxWidth="32.0" minHeight="32.0" minWidth="32.0" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #ffedd5; -fx-background-radius: 50%;">
                                            <Label styleClass="text-gold text-lg" text="&#x1f525;" />
                                        </StackPane>
                                        <Label fx:id="streakCount" styleClass="font-black text-slate-700" text="0 Days" />
                                    </HBox>
                                    <VBox alignment="CENTER_LEFT" minWidth="180.0" spacing="6.0">
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <Label fx:id="levelLabel" styleClass="text-xs font-bold text-slate-400" text="LEVEL 1" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="xpLabel" styleClass="text-xs font-bold text-slate-400" text="0 / 1000 XP" />
                                        </HBox>
                                        <ProgressBar fx:id="prog1" maxWidth="Infinity" progress="0.0" styleClass="xp-bar" />
                                    </VBox>
                                </HBox>
                                
                                <StackPane fx:id="notifStack" alignment="CENTER">
                                    <children>
                                        <Button fx:id="notifBtn" mnemonicParsing="false" onAction="#onNotifClick" styleClass="topbar-icon-btn" text="&#x1f514;">
                                            <font><Font size="18.0" /></font>
                                        </Button>
                                        <Label fx:id="notifBadge" mouseTransparent="true" styleClass="notif-badge" text="0" visible="false">
                                            <StackPane.alignment>TOP_RIGHT</StackPane.alignment>
                                            <StackPane.margin>
                                                <Insets right="2.0" top="2.0" />
                                            </StackPane.margin>
                                        </Label>
                                    </children>
                                </StackPane>
                                
                                <HBox fx:id="profileTrigger" alignment="CENTER" onMouseClicked="#onProfileClick" spacing="12.0" styleClass="profile-pill">
                                    <StackPane>
                                        <Circle fx:id="avatarCircle" fill="#4a90e2" radius="20.0" styleClass="avatar-circle" />
                                        <Label fx:id="avatarInitial" styleClass="font-bold" text="A" textFill="WHITE" />
                                    </StackPane>
                                    <VBox alignment="CENTER_LEFT">
                                        <Label fx:id="topbarUserName" styleClass="text-sm font-bold text-slate-800" text="Alex Johnson" />
                                        <Label fx:id="topbarUserRole" styleClass="text-xs text-slate-400" text="Explorer Rank" />
                                    </VBox>
                                    <Label fx:id="profileChevron" styleClass="text-slate-400" text="v" />
                                </HBox>
                                <Region prefWidth="120.0" />
                            </children>
                            <padding><Insets left="24" right="24" /></padding>
                        </HBox>

                        <HBox alignment="TOP_RIGHT" pickOnBounds="false" spacing="10.0" style="-fx-padding: 15 20 0 0;" StackPane.alignment="TOP_RIGHT">
                            <children>
                                <Button mnemonicParsing="false" onAction="#onMinimizeWindow" styleClass="window-btn, window-btn-min" />
                                <Button mnemonicParsing="false" onAction="#onMaximizeWindow" styleClass="window-btn, window-btn-max" />
                                <Button mnemonicParsing="false" onAction="#onCloseWindow" styleClass="window-btn, window-btn-close" />
                            </children>
                        </HBox>
                    </children>
                </StackPane>
            </top>
            <left>
        <VBox fx:id="sidebar" prefWidth="250.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding><Insets bottom="24" left="16" right="16" top="24" /></padding>
            <children>
                <HBox fx:id="sidebarHeader" alignment="CENTER_LEFT" spacing="12.0">
                    <StackPane fx:id="sidebarIcon" prefHeight="40" prefWidth="40" styleClass="sidebar-icon-bg">
                        <Label styleClass="text-xl" text="&#x1f393;" textFill="WHITE" />
                    </StackPane>
                    <VBox>
                        <Label styleClass="topbar-logo-text" text="Skillora" />
                        <Label fx:id="sidebarLevelLabel" styleClass="text-xs font-bold text-slate-400" text="QUEST LEVEL: 1" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="collapseBtn" mnemonicParsing="false" onAction="#onToggleSidebar" styleClass="topbar-icon-btn">
                        <graphic>
                            <Label fx:id="collapseIcon" text="‹" />
                        </graphic>
                    </Button>
                </HBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                    <VBox spacing="4.0">
                        <VBox.margin>
                            <Insets top="32.0" />
                        </VBox.margin>
                        
                        <Label styleClass="sidebar-section-header" text="MAIN MENU" />
                    
                    <Button fx:id="navHome" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavHome" styleClass="nav-btn, nav-active">
                        <graphic>
                            <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f3e0;" /><Label fx:id="lblHome" styleClass="text-sm" text="Dashboard" /></HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="navCourses" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavCourses" styleClass="nav-btn">
                        <graphic>
                            <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f4da;" /><Label fx:id="lblCourses" styleClass="text-sm" text="Courses" /></HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="navQuizzes" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavQuizzes" styleClass="nav-btn">
                        <graphic>
                            <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f4dd;" /><Label fx:id="lblQuizzes" styleClass="text-sm" text="Quizzes" /></HBox>
                        </graphic>
                    </Button>
                    <VBox fx:id="quizSubmenu" managed="false" spacing="4.0" visible="false" styleClass="quiz-submenu">
                        <children>
                            <Button fx:id="navQuizChoose" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onQuizChoose" styleClass="nav-btn, quiz-subnav-btn">
                                <graphic>
                                    <HBox spacing="10"><Label styleClass="text-sm emoji-icon" text="&#x25b6;" /><Label fx:id="lblQuizChoose" styleClass="text-sm" text="Passer un quiz" /></HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="navQuizManage" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onQuizManage" styleClass="nav-btn, quiz-subnav-btn">
                                <graphic>
                                    <HBox spacing="10"><Label styleClass="text-sm emoji-icon" text="&#x2699;" /><Label fx:id="lblQuizManage" styleClass="text-sm" text="Quiz" /></HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="navQuizQuestions" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onQuizQuestions" styleClass="nav-btn, quiz-subnav-btn">
                                <graphic>
                                    <HBox spacing="10"><Label styleClass="text-sm emoji-icon" text="?" /><Label fx:id="lblQuizQuestions" styleClass="text-sm" text="Questions" /></HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="navQuizAnswers" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onQuizAnswers" styleClass="nav-btn, quiz-subnav-btn">
                                <graphic>
                                    <HBox spacing="10"><Label styleClass="text-sm emoji-icon" text="&#x2713;" /><Label fx:id="lblQuizAnswers" styleClass="text-sm" text="Reponses" /></HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="navQuizHistory" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onQuizHistory" styleClass="nav-btn, quiz-subnav-btn">
                                <graphic>
                                    <HBox spacing="10"><Label styleClass="text-sm emoji-icon" text="&#x23f1;" /><Label fx:id="lblQuizHistory" styleClass="text-sm" text="Historique" /></HBox>
                                </graphic>
                            </Button>
                        </children>
                    </VBox>
                    <Button fx:id="navLeaderboard" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavLeaderboard" styleClass="nav-btn">
                        <graphic>
                            <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f3c6;" /><Label fx:id="lblLeaderboard" styleClass="text-sm" text="Leaderboard" /></HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="navProgress" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavProgress" styleClass="nav-btn">
                        <graphic>
                            <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f4ca;" /><Label fx:id="lblProgress" styleClass="text-sm" text="Achievements" /></HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="navShop" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavShop" styleClass="nav-btn">
                        <graphic>
                            <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f6cd;" /><Label fx:id="lblShop" styleClass="text-sm" text="Shop" /></HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="navEvent" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavEvent" styleClass="nav-btn">
                        <graphic>
                            <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f3c0;" /><Label fx:id="lblEvent" styleClass="text-sm" text="Event" /></HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="navReservation" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavReservation" styleClass="nav-btn">
                        <graphic>
                            <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f4cb;" /><Label fx:id="lblReservation" styleClass="text-sm" text="Reservation" /></HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="navCommunity" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavCommunity" styleClass="nav-btn">
                        <graphic>
                            <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f4ac;" /><Label fx:id="lblCommunity" styleClass="text-sm" text="Community" /></HBox>
                        </graphic>
                    </Button>
                    
                    <VBox fx:id="adminSection" spacing="4.0" visible="false" managed="false">
                        <VBox.margin><Insets top="20.0" /></VBox.margin>
                        <children>
                            <Label styleClass="sidebar-section-header" text="ADMINISTRATION" />
                            <Button fx:id="navAdmin" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavAdmin" styleClass="nav-btn">
                                <graphic>
                                    <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f465;" /><Label fx:id="lblAdmin" styleClass="text-sm" text="Users" /></HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="navAdminCourses" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavAdminCourses" styleClass="nav-btn">
                                <graphic>
                                    <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f4da;" /><Label fx:id="lblAdminCourses" styleClass="text-sm" text="Manage Courses" /></HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="navAdminShop" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavAdminShop" styleClass="nav-btn">
                                <graphic>
                                    <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f6cd;" /><Label fx:id="lblAdminShop" styleClass="text-sm" text="Manage Shop" /></HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="navAdminEvents" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavAdminEvents" styleClass="nav-btn">
                                <graphic>
                                    <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f3c0;" /><Label fx:id="lblAdminEvents" styleClass="text-sm" text="Manage Events" /></HBox>
                                </graphic>
                            </Button>
                            <Button fx:id="navAdminReservations" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavAdminReservations" styleClass="nav-btn">
                                <graphic>
                                    <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x1f4cb;" /><Label fx:id="lblAdminReservations" styleClass="text-sm" text="Manage Reservations" /></HBox>
                                </graphic>
                            </Button>
                        </children>
                    </VBox>
                </VBox>
                </ScrollPane>

                    <Region VBox.vgrow="ALWAYS" />
                    
                    <Label styleClass="sidebar-section-header" text="ACCOUNT" />
                    <Button fx:id="navSettings" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onNavSettings" styleClass="nav-btn">
                        <graphic>
                            <HBox spacing="12"><Label styleClass="text-sm emoji-icon" text="&#x2699;" /><Label fx:id="lblSettings" styleClass="text-sm" text="Settings" /></HBox>
                        </graphic>
                    </Button>
                    <Button fx:id="navLogout" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLogout" styleClass="nav-btn, nav-logout-btn">
                        <graphic>
                            <HBox spacing="12">
                                <Label styleClass="text-sm emoji-icon" text="&#x1f6aa;" />
                                <Label fx:id="lblLogout" styleClass="text-sm" text="Logout" />
                            </HBox>
                        </graphic>
                    </Button>
            </children>
        </VBox>
    </left>
    
    <!-- CENTER CONTENT -->
    <center>
        <StackPane>
            <ScrollPane fx:id="contentScroll" fitToWidth="true" styleClass="content-scroll">
                <StackPane>
                    
                    <!-- THE REDESIGNED DASHBOARD (pageHome) -->
                    <VBox fx:id="pageHome" styleClass="page-root" spacing="32.0">
                        <padding><Insets bottom="40" left="36" right="36" top="36" /></padding>
                        <Label fx:id="greetingLabel" styleClass="text-xl font-black text-slate-800" text="Good morning, Alex &#x1f44b;" />
                        
                        <HBox spacing="32.0">
                            <!-- LEFT COLUMN (Main Content) -->
                            <VBox spacing="32.0" HBox.hgrow="ALWAYS">
                                <!-- ACTIVE QUEST CARD -->
                                <VBox styleClass="game-card" spacing="24.0">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label styleClass="quest-card-title" text="Advanced JavaFX Architecture" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <HBox style="-fx-background-color: #fef3c7; -fx-padding: 6 12; -fx-background-radius: 20px;" alignment="CENTER" spacing="6">
                                            <Label text="&#x2728;" styleClass="text-gold" />
                                            <Label text="ACTIVE QUEST" styleClass="text-xs font-black text-gold" />
                                        </HBox>
                                    </HBox>
                                    <Label styleClass="quest-card-copy" text="Conquer the final module of Layout Managers to unlock the 'UI Architect' badge and earn massive XP." wrapText="true"/>
                                    
                                    <HBox spacing="16.0">
                                        <VBox style="-fx-background-color: #0e6eceff; -fx-padding: 16; -fx-background-radius: 12px;" HBox.hgrow="ALWAYS" spacing="8.0">
                                            <Label text="REWARD UPON COMPLETION" styleClass="section-kicker" style="-fx-text-fill: white;" />
                                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                <Label text="&#x1f48e;" styleClass="text-gold text-xl" />
                                                <Label text="+500 XP" styleClass="font-black text-slate-700 text-xl" />
                                            </HBox>
                                        </VBox>
                                        <VBox style="-fx-background-color: #1e7bd8ff; -fx-padding: 16; -fx-background-radius: 12px;" HBox.hgrow="ALWAYS" spacing="8.0">
                                            <Label text="UNLOCKABLES" styleClass="section-kicker" style="-fx-text-fill: white;" />
                                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                <Label text="&#x1f396;" styleClass="text-secondary text-xl" />
                                                <Label text="Expert Badge" styleClass="font-black text-slate-700 text-xl" />
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                    
                                    <VBox spacing="8.0">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="QUEST PROGRESS" styleClass="section-kicker text-primary" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label text="68%" styleClass="text-sm font-black text-primary" />
                                        </HBox>
                                        <ProgressBar fx:id="prog2" progress="0.68" maxWidth="1.7976931348623157E308" styleClass="xp-bar" />
                                    </VBox>
                                    
                                    <Button styleClass="primary-btn" text="&#x25b6; RESUME QUEST" onAction="#onResume" />
                                </VBox>
                                
                                <!-- UNLOCKED COLLECTIBLES -->
                                <VBox spacing="16.0">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label styleClass="panel-title" text="&#x1f396; Unlocked Collectibles" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label styleClass="text-sm font-bold text-primary" text="Gallery View" style="-fx-cursor: hand;" />
                                    </HBox>
                                    <HBox spacing="16.0">
                                        <!-- Collectible 1 -->
                                        <VBox styleClass="collectible-card" HBox.hgrow="ALWAYS">
                                            <StackPane style="-fx-background-color: #eff6ff; -fx-background-radius: 50%;" prefWidth="64" prefHeight="64">
                                                <Label text="&#x1f4bb;" styleClass="text-3xl" />
                                            </StackPane>
                                            <Label text="Syntax Ace" styleClass="font-black text-sm text-slate-800" />
                                            <Label text="Earned 2d ago" styleClass="text-xs text-slate-400" />
                                        </VBox>
                                        <!-- Collectible 2 -->
                                        <VBox styleClass="collectible-card" HBox.hgrow="ALWAYS">
                                            <StackPane style="-fx-background-color: #eff6ff; -fx-background-radius: 50%;" prefWidth="64" prefHeight="64">
                                                <Label text="&#x1f3a8;" styleClass="text-3xl" />
                                            </StackPane>
                                            <Label text="UI Virtuoso" styleClass="font-black text-sm text-slate-800" />
                                            <Label text="Earned 1w ago" styleClass="text-xs text-slate-400" />
                                        </VBox>
                                        <!-- Collectible 3 -->
                                        <VBox styleClass="collectible-card" HBox.hgrow="ALWAYS">
                                            <StackPane style="-fx-background-color: #fff7ed; -fx-background-radius: 50%;" prefWidth="64" prefHeight="64">
                                                <Label text="&#x23f1;" styleClass="text-3xl" />
                                            </StackPane>
                                            <Label text="Speed Demon" styleClass="font-black text-sm text-slate-800" />
                                            <Label text="Earned 2w ago" styleClass="text-xs text-slate-400" />
                                        </VBox>
                                        <!-- Collectible 4 (Locked) -->
                                        <VBox styleClass="collectible-card locked-collectible" HBox.hgrow="ALWAYS">
                                            <StackPane style="-fx-background-color: #f1f5f9; -fx-background-radius: 50%;" prefWidth="64" prefHeight="64">
                                                <Label text="&#x1f512;" styleClass="text-3xl" />
                                            </StackPane>
                                            <Label text="Master Coder" styleClass="font-black text-sm text-slate-400" />
                                            <Label text="Locked" styleClass="text-xs text-slate-400" />
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </VBox>
                            
                            <!-- RIGHT COLUMN (Widgets) -->
                            <VBox spacing="32.0" prefWidth="300.0">
                                <!-- Daily Loot -->
                                <VBox spacing="16.0">
                                    <Label styleClass="panel-title" text="Daily Loot" />
                                    <VBox styleClass="widget-card" spacing="16.0">
                                        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-cursor: hand;">
                                            <StackPane style="-fx-background-color: #2563eb; -fx-background-radius: 8px;" prefWidth="40" prefHeight="40">
                                                <Label text="&#x2753;" styleClass="text-white"/>
                                            </StackPane>
                                            <VBox>
                                                <Label text="Daily Quiz" styleClass="font-black text-slate-800" />
                                                <Label text="+50 XP" styleClass="text-xs text-slate-500" />
                                            </VBox>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-cursor: hand;">
                                            <StackPane style="-fx-background-color: #3b82f6; -fx-background-radius: 8px;" prefWidth="40" prefHeight="40">
                                                <Label text="&#x2328;" styleClass="text-white"/>
                                            </StackPane>
                                            <VBox>
                                                <Label text="Code Battle" styleClass="font-black text-slate-800" />
                                                <Label text="+100 XP" styleClass="text-xs text-slate-500" />
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                </VBox>
                                
                                <!-- Streak Card -->
                                <VBox styleClass="streak-card" spacing="16.0">
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <StackPane style="-fx-background-color: #F59E0B; -fx-background-radius: 8px;" prefWidth="32" prefHeight="32">
                                            <Label text="&#x2b50;" />
                                        </StackPane>
                                        <Label text="Learning Streak" styleClass="font-black text-white" />
                                    </HBox>
                                    <Label text="Complete 1 more lesson to maintain your 7-day streak!" styleClass="text-xs text-slate-400" wrapText="true" />
                                    <HBox spacing="8.0">
                                        <Region style="-fx-background-color: #F59E0B; -fx-background-radius: 4px;" prefHeight="6" HBox.hgrow="ALWAYS"/>
                                        <Region style="-fx-background-color: #F59E0B; -fx-background-radius: 4px;" prefHeight="6" HBox.hgrow="ALWAYS"/>
                                        <Region style="-fx-background-color: #F59E0B; -fx-background-radius: 4px;" prefHeight="6" HBox.hgrow="ALWAYS"/>
                                        <Region style="-fx-background-color: #F59E0B; -fx-background-radius: 4px;" prefHeight="6" HBox.hgrow="ALWAYS"/>
                                        <Region style="-fx-background-color: #F59E0B; -fx-background-radius: 4px;" prefHeight="6" HBox.hgrow="ALWAYS"/>
                                        <Region style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 4px;" prefHeight="6" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <Label text="&quot;The grind never stops!&quot;" styleClass="text-xs text-gold" style="-fx-font-style: italic;" />
                                </VBox>
